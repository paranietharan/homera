{
  "name": "Homera - Custom New Tab Wallpaper",
  "description": "Personalize your Chrome New Tab page with custom wallpapers, presets, and a clean dashboard.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Homera Wallpaper Settings"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ]
}
